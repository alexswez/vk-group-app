# Пример настроек окружения для фронтенда.
#
# Чтобы использовать свои значения, скопируйте этот файл в .env.local
# (он не попадает в git, потому что указан в .gitignore).
#
# Адрес сервера общего хранилища. Если переменная не задана,
# приложение по умолчанию обращается к http://localhost:3000.
VITE_API_URL=http://localhost:3000

# ID приложения ВКонтакте (появится после создания приложения в кабинете разработчика).
# Нужен, чтобы кнопка «Поделиться» формировала правильную ссылку https://vk.com/app<ID>#/tasks
VITE_APP_ID=

# Поставьте 1, чтобы включить консоль разработчика Eruda в опубликованном приложении
# (удобно отлаживать на телефоне). Для обычной работы оставьте пустым.
VITE_DEBUG=
