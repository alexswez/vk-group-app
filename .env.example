# Пример настроек окружения для фронтенда.
#
# Чтобы использовать свои значения, скопируйте этот файл в .env.local
# (он не попадает в git, потому что указан в .gitignore).
#
# Адрес сервера общего хранилища. Если переменная не задана,
# приложение по умолчанию обращается к http://localhost:3000.
VITE_API_URL=http://localhost:3000

# ID приложения ВКонтакте (появится после создания приложения в кабинете разработчика).
# Нужен, чтобы кнопка «Поделиться» формировала правильную ссылку https://vk.com/app<ID>#/tasks
VITE_APP_ID=

# Поставьте 1, чтобы включить консоль разработчика Eruda в опубликованном приложении
# (удобно отлаживать на телефоне). Для обычной работы оставьте пустым.
VITE_DEBUG=

# ---------------------------------------------------------------------------
# ОБЩЕЕ ХРАНИЛИЩЕ. Достаточно настроить ОДИН из двух вариантов.
#
# Вариант 1 (основной): Supabase — PostgreSQL в облаке со встроенным REST API.
# Адрес: Project Settings → Data API → Project URL.
# Ключ: Project Settings → API Keys → Publishable key (подходит и старый anon-ключ из JWT).
# Публичный ключ не является секретом: он предназначен для фронтенда, доступ ограничивают
# политики базы (Row Level Security). Секретный ключ (sb_secret_...) сюда вставлять НЕЛЬЗЯ.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Вариант 2: собственный сервер Express (папка server/).
# Если заданы оба варианта, приоритет у Supabase.
# VITE_API_URL=http://localhost:3000
