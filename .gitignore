# Что НЕ попадает в git.

# Зависимости: их восстанавливают командой npm install, хранить их в репозитории не нужно.
node_modules/

# Результаты сборки.
build/
dist/
# Архив, который создаёт утилита деплоя перед выгрузкой на хостинг ВКонтакте.
build.zip
*.zip

# Локальные настройки окружения: у каждого разработчика свои.
.env
.env.local

# База данных сервера создаётся автоматически.
server/data/

# Разное «мусорное».
*.log
.DS_Store
